# Homelab Assistant Agent — Environment Configuration
#
# This file tells the agent where to find private configuration files
# that contain environment-specific details (domains, IPs, VLAN mappings).
#
# Copy this file to .env and update paths for your local setup.
# .env is gitignored — never commit it.

# Path to your local clone of the homelab-automation repo
HOMELAB_AUTOMATION_PATH=/path/to/homelab-automation

# NextDNS: VLAN-to-subdomain mapping and DNS conventions
NEXTDNS_DNS_CONFIG=${HOMELAB_AUTOMATION_PATH}/nextdns/dns-config.md

# Proxmox: Terraform config and cluster-specific settings (future use)
# PROXMOX_TERRAFORM_PATH=${HOMELAB_AUTOMATION_PATH}/terraform

# Ansible: Inventory and playbooks (future use)
# ANSIBLE_PATH=${HOMELAB_AUTOMATION_PATH}/ansible
