[Unit]
Description=Homelab Discord read and approval transport
After=network-online.target homelab-executor.service
Wants=network-online.target

[Service]
Type=simple
User=homelab-discord
Group=homelab-observe
SupplementaryGroups=homelab-approve
WorkingDirectory=/opt/homelab-monitor
EnvironmentFile=/etc/homelab-monitor/discord.env
ExecStart=/opt/homelab-monitor/.venv/bin/python -m homelab_monitor --db /var/lib/homelab-monitor/monitor.db --socket /run/homelab-executor/control.sock discord --identity /etc/homelab-monitor/discord-identity.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/homelab-monitor

[Install]
WantedBy=multi-user.target
