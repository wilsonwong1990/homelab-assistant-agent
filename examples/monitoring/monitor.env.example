# Give each service only the variables it needs; do not source this as shell code.
# monitor.env
PROXMOX_AUTHORIZATION=PVEAPIToken=observer@pve!monitor=REPLACE_SECRET
UNIFI_READ_API_KEY=REPLACE_SECRET
HA_AUTHORIZATION=Bearer REPLACE_SECRET
# notify.env
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ID/REPLACE_SECRET
# worker.env: no credentials required.
# Discord approval bot uses a separate identity from a Hermes gateway bot.
DISCORD_BOT_TOKEN=REPLACE_SECRET
# Executor only, if IssueOps is enabled. Never provide this to Hermes.
GITHUB_READ_TOKEN=REPLACE_READ_ONLY_REPO_TOKEN
