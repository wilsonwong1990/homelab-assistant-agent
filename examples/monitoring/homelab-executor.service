[Unit]
Description=Restricted homelab runbook executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab-executor
Group=homelab-approve
SupplementaryGroups=homelab-observe
WorkingDirectory=/opt/homelab-monitor
EnvironmentFile=/etc/homelab-monitor/executor.env
RuntimeDirectory=homelab-executor
RuntimeDirectoryMode=0750
ExecStart=/opt/homelab-monitor/.venv/bin/python -m homelab_monitor --db /var/lib/homelab-monitor/monitor.db --socket /run/homelab-executor/control.sock executor --policy /etc/homelab-monitor/execution-policy.json --action-db /var/lib/homelab-executor/actions.db --kill-switch /etc/homelab-monitor/STOP
Restart=on-failure
RestartSec=10
UMask=0027
# sudo needs privilege elevation here; the sudoers entry is per exact unit.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/homelab-executor
ReadOnlyPaths=/var/lib/homelab-monitor

[Install]
WantedBy=multi-user.target
