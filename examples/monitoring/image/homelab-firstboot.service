[Unit]
Description=Homelab monitoring first-boot install
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/homelab-monitor/.firstboot-done

[Service]
Type=oneshot
# Network, apt, PyPI and the model download can be slow or briefly unavailable.
ExecStart=/opt/homelab-monitor-src/examples/monitoring/deploy/install.sh --source /opt/homelab-monitor-src --install-ollama --no-sleep
ExecStartPost=/usr/bin/touch /var/lib/homelab-monitor/.firstboot-done
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
